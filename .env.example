# ============ CORE (required — app won't boot without these) ============
NODE_ENV=production
PORT=5000

# Postgres (Neon). Full connection string incl. sslmode=require.
DATABASE_URL=postgresql://user:pass@host.neon.tech/db?sslmode=require

# Redis cache (Upstash). rediss:// TLS URL.
REDIS_URL=rediss://default:pass@your-cache.upstash.io:6379

# JWT secrets — must be 32+ chars AND different from each other.
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-32chars-min
JWT_REFRESH_SECRET=change-me-to-a-DIFFERENT-long-random-string

# ============ QUEUE / WORKER ============
# Dedicated noeviction Redis for BullMQ. Falls back to REDIS_URL if unset,
# but in prod use a separate eviction-off database.
REDIS_QUEUE_URL=rediss://default:pass@your-queue.upstash.io:6379
REDIS_PREFIX=abhicabs
WORKER_CONCURRENCY=5
JOB_MAX_ATTEMPTS=8
JOB_BACKOFF_MS=5000

# ============ REPORTING (Day 13) ============
# Optional read replica for reports. Unset = uses DATABASE_URL.
REPORTING_DATABASE_URL=
REPORT_TTL_LIVE=600
REPORT_TTL_GST=3600
REPORT_EXPORT_TTL=3600
REPORT_STORAGE=mock

# ============ AUTH / TOKENS ============
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# ============ SEED ADMIN (first boot) ============
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@abhicabs.com
SEED_ADMIN_PASSWORD=change-me-immediately

# ============ CORS ============
CORS_ORIGINS=https://your-frontend-domain.com

# ============ PAYMENTS ============
# mock for now; razorpay when you go live.
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=change-me
PAYMENT_ADVANCE_PERCENT=25
PARTIAL_PAYMENT_PCT=25
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ============ NOTIFICATIONS / OTP (MSG91) ============
NOTIFY_PROVIDER=mock
OTP_DEV_MODE=true
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_MAX_PER_DAY=10
OTP_RESEND_COOLDOWN=60

# ============ MAPS ============
MAPS_PROVIDER=mock
MAPS_API_KEY=
MAPS_TIMEOUT_MS=5000
MAPS_BREAKER_THRESHOLD=5
MAPS_BREAKER_COOLDOWN_MS=30000

# ============ BILLING / GST ============
GST_RATE_PCT=5
INVOICE_SAC_CODE=996412
INVOICE_SERIES=ABH

# ============ DISPATCH / FARE / GPS TUNING (safe defaults) ============
DISPATCH_HOLD_BUFFER_MIN=60
DISPATCH_DEFAULT_TRIP_MIN=120
DISPATCH_OFFER_TIMEOUT_MIN=2
BOOKING_MAX_ADVANCE_DAYS=90
BOOKING_MIN_LEAD_MINUTES=15
CANCEL_FREE_MINUTES=30
GEO_AVG_SPEED_KMPH=30
GEO_DETOUR_FACTOR=1.4
MAX_TRIP_KM=500
MAX_ADDRESSES_PER_CUSTOMER=20
GPS_HEARTBEAT_SECONDS=30
GPS_CHECKPOINT_SECONDS=60
GPS_POSITION_TTL_SECONDS=120
GPS_MAX_SPEED_KMPH=150
GPS_MAX_JUMP_KM=5
IDEMPOTENCY_TTL_HOURS=24
IDEMPOTENCY_STALE_MINUTES=30