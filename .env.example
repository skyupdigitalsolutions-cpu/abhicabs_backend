NODE_ENV=development
PORT=5000

# PostgreSQL — local or Neon/managed
DATABASE_URL="postgresql://postgres:devpass@localhost:5432/taxirental?schema=public"

# Generate each with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET=CHANGE_ME_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_different_min_32_chars

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Comma-separated exact origins. Never "*" when credentials are enabled.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Seeded first admin (change the password after first login)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345